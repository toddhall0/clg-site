---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Our Team | Camelback Law Group";
const description = "Meet the attorneys and staff of Camelback Law Group — a boutique commercial real estate and environmental law firm in Phoenix, Arizona.";

const attorneys = [
  { name: "Todd Hall", role: "Partner / Founder", photo: "/images/team/todd-hall-bg.jpg", href: "/team/todd-hall" },
  { name: "James J. Hamula", role: "Partner", photo: "/images/team/james-hamula-bg.jpg", href: "/team/james-hamula" },
  { name: "Blaine Rice", role: "Partner", photo: "/images/team/blaine-rice-bg.jpg", href: "/team/blaine-rice" },
];

const staff = [
  { name: "Rachel Saxelby", role: "Paralegal", photo: "/images/team/rachel-saxelby-bg.jpg", href: "/team/rachel-saxelby" },
  { name: "Melissa Vizcarra", role: "Paralegal", photo: "/images/team/melissa-vizcarra-bg.jpg", href: "/team/melissa-vizcarra" },
  { name: "Kathy Vizcarra", role: "Legal Assistant", photo: "/images/team/kathy-vizcarra-bg.jpg", href: "/team/kathy-vizcarra" },
];
---

<BaseLayout title={title} description={description}>
  <article class="team">
    <header class="team-hero">
      <div class="team-hero-bg"></div>
      <div class="team-hero-container">
        <span class="team-eyebrow">Camelback Law Group</span>
        <h1>Our Team</h1>
        <p>Senior counsel on every matter. Our attorneys bring principal-side experience to commercial real estate and environmental transactions across Arizona.</p>
      </div>
    </header>

    <div class="team-content">
      <h2 class="team-section-title">Attorneys</h2>
      <div class="team-grid">
        {attorneys.map((a) => (
          <a class="member-card" href={a.href}>
            <div class="member-photo">
              <img src={a.photo} alt={a.name} loading="lazy" />
            </div>
            <div class="member-info">
              <h3>{a.name}</h3>
              <p class="member-role">{a.role}</p>
              <span class="member-link">View Profile →</span>
            </div>
          </a>
        ))}
      </div>

      <h2 class="team-section-title">Paralegals &amp; Staff</h2>
      <div class="team-grid">
        {staff.map((a) => (
          <a class="member-card" href={a.href}>
            <div class="member-photo">
              <img src={a.photo} alt={a.name} loading="lazy" />
            </div>
            <div class="member-info">
              <h3>{a.name}</h3>
              <p class="member-role">{a.role}</p>
              <span class="member-link">View Profile →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .team-hero {
    position: relative;
    padding: calc(var(--header-height) + var(--spacing-2xl)) 0 var(--spacing-2xl);
    background: var(--color-charcoal-light);
    text-align: center;
  }

  .team-hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 50% 0%, rgba(26, 155, 165, 0.12) 0%, transparent 55%),
      var(--color-charcoal-light);
    z-index: 0;
  }

  .team-hero-container {
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .team-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-teal);
    margin-bottom: var(--spacing-sm);
  }

  .team-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3rem);
    color: var(--color-white);
    margin-bottom: var(--spacing-sm);
  }

  .team-hero-container p {
    font-size: 1.1rem;
    color: var(--color-gray-400);
    line-height: 1.7;
  }

  .team-content {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--spacing-2xl) var(--spacing-md) var(--spacing-3xl);
  }

  .team-section-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-white);
    margin-bottom: var(--spacing-lg);
    padding-bottom: var(--spacing-xs);
    border-bottom: 2px solid var(--color-teal);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-2xl);
  }

  .member-card {
    display: flex;
    flex-direction: column;
    background: var(--color-charcoal-light);
    border: 1px solid var(--color-charcoal-lighter);
    border-radius: 10px;
    overflow: hidden;
    transition: border-color var(--transition-base), transform var(--transition-base);
    color: var(--color-cream);
  }

  .member-card:hover {
    border-color: var(--color-teal);
    transform: translateY(-4px);
    color: var(--color-cream);
  }

  .member-photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-charcoal);
  }

  .member-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .member-info {
    padding: var(--spacing-md) var(--spacing-lg) var(--spacing-lg);
  }

  .member-card h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--color-white);
    margin-bottom: 0.1rem;
  }

  .member-role {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-teal-sky);
    margin-bottom: var(--spacing-sm);
  }

  .member-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-teal);
  }

  @media (max-width: 900px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
